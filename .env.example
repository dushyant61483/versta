# Copy this file to .env and fill in real values when the backend/AI
# integrations are connected. Never commit the real .env file.
# Vite only exposes variables prefixed with VITE_ to the frontend — keep
# any secret keys (weather API, AI API) on a backend server instead, and
# call that server from the services in src/services/.

VITE_API_BASE_URL=http://localhost:4000
